# Runs the stack updater once in hosted mode (D-032); medical-chatbot-update.timer starts it every 15 minutes.
# Assumes the default Ubuntu user and the repository cloned to /home/ubuntu/Medical-ChatBot (hosting/oracle/README.md).
[Unit]
Description=Update the Medical-ChatBot hosted stack to the latest release
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Medical-ChatBot
ExecStart=/usr/bin/python3 /home/ubuntu/Medical-ChatBot/scripts/update_stack.py

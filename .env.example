# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Variables already set in your shell override these.

# Required
NEO4J_PASSWORD=

# Optional (defaults shown)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT=5
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Logging (logs/<year>/<Month>/<name>.log, rotated at midnight)
LOG_LEVEL=DEBUG
LOG_BACKUP_COUNT=30
# LOG_DIR=logs

# Language-model understanding (D-027). Docker turns it on unless this says off; questions then go to Ollama's cloud.
# LLM_UNDERSTANDING=off
# OLLAMA_URL=http://localhost:11434
# LLM_MODEL=gpt-oss:120b-cloud
